Table "especialidade" {
  "id_especialidade" integer [pk]
  "nome" text [unique, not null]
}

Table "regime_trabalho" {
  "id_regime" integer [pk]
  "descricao" text [unique, not null]
  "carga_horaria_semanal" integer [not null]
}

Table "medico" {
  "id_medico" integer [pk]
  "nome" text [not null]
  "crm" text [unique, not null]
  "email" text [unique, not null]
  "data_admissao" text [not null]
  "id_especialidade" integer [not null]
  "id_regime" integer [not null]
}

Table "predio" {
  "id_predio" integer [pk]
  "nome" text [unique, not null]
  "endereco" text [not null]
}

Table "departamento" {
  "id_departamento" integer [pk]
  "nome" text [unique, not null]
  "andar" integer [not null]
  "id_predio" integer [unique, not null]
}

Table "departamento_especialidade" {
  "id_departamento" integer [pk]
  "id_especialidade" integer [pk]
}

Table "turno" {
  "id_turno" integer [pk]
  "nome" text [unique, not null]
  "hora_inicio" text [not null]
  "hora_fim" text [not null]
  "duracao_horas" integer [not null]
}

Table "alocacao" {
  "id_alocacao" integer [pk]
  "id_medico" integer [unique, not null]
  "id_departamento" integer [not null]
  "id_turno" integer [unique, not null]
  "dia_semana" integer [unique, not null]
}

Ref: "medico"."id_especialidade" > "especialidade"."id_especialidade"
Ref: "medico"."id_regime" > "regime_trabalho"."id_regime"
Ref: "departamento"."id_predio" > "predio"."id_predio"
Ref: "departamento_especialidade"."id_departamento" > "departamento"."id_departamento"
Ref: "departamento_especialidade"."id_especialidade" > "especialidade"."id_especialidade"
Ref: "alocacao"."id_medico" > "medico"."id_medico"
Ref: "alocacao"."id_departamento" > "departamento"."id_departamento"
Ref: "alocacao"."id_turno" > "turno"."id_turno"
